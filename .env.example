# Configurações do servidor
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# IA IZA (configurar quando disponível)
IZA_API_URL=https://api.iza.example.com
IZA_API_KEY=your-iza-api-key-here

# JWT (para autenticação futura)
JWT_SECRET=change-me-in-production-use-strong-secret

# Database (para implementação futura)
# DATABASE_URL=postgresql://user:password@localhost:5432/escuta_df
